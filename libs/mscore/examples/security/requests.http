# Keycloak (authentication flow):  password grant
# @name login

POST http://localhost:8080/realms/mscore/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password
&username=user-1
&password=Bilal@1996
&client_id=api-test
&scope=openid
###


# Keycloak: fetch user info
@access_token = {{login.response.body.access_token}}

GET http://localhost:8080/realms/mscore/protocol/openid-connect/userinfo
Authorization: Bearer {{ access_token }}
###




