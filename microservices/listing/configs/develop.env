#
# [-] Microservice 
#
MS__NAME="listing-microservice"
MS__PORT=80
MS__NUM_WORKERS=1
MS__ENVIRONMENT="development"
MS__RELOADING=True
MS__LOG_LEVEL="TRACE"
MS__DEBUG=True


#
# [-] Auth Provider
# 
AUTH_PROVIDER__PROVIDER=keycloak
AUTH_PROVIDER__SERVER_URL="https://keycloak.proseva.net"
AUTH_PROVIDER__REALM_NAME="proseva"
AUTH_PROVIDER__CLIENT_ID="listing-microservice"
AUTH_PROVIDER__CLIENT_SECRET_KEY="676EADzwv09a7fAT3CYfyWn8bJuBePA8" # TODO: use hashicorp vault


#
# [-] Swagger
# 
# Keycloak client ID used by Swagger UI for OAuth2 authentication.
SWAGGER__CLIENT_ID=listing-swagger-ui

# Swagger UI title
SWAGGER__TITLE="Listing API"

# Swagger UI description
SWAGGER__DESCRIPTION="Listing API for ProSeva Platform"

# Enable OAuth2 Authorization Code Grant with PKCE (S256).
# Default: True
# SWAGGER__USE_PKCE_WITH_AUTHORIZATION_CODE_GRANT=True

# Display the duration of each API request in Swagger UI.
# Default: True
# SWAGGER__DISPLAY_REQUEST_DURATION=True

# Display a search/filter box for API operations.
# Default: True
# SWAGGER__FILTER=True

# Sort API operations alphabetically.
# Default: alpha
# SWAGGER__OPERATIONS_SORTER=alpha

# Keep OAuth2 authorization credentials after refreshing the Swagger UI page.
# Default: True
# SWAGGER__PERSIST_AUTHORIZATION=True

# OAuth2 scopes exposed in the Swagger UI authorization flow.
SWAGGER__OAUTH2_SCOPES={"listing:read":"Read listings (default scope)","listing:create":"Create listings (default scope)","listing:update":"Update listings (default scope)","listing:moderate":"Moderate listings (optional scope)"}


#
# [-] Monitoring
#


#
# [-] Database
#
DB__LISTING__URL="postgresql+asyncpg://admin:IJOfK9Rz9D@listing-db/listing"
DB__LISTING__ECHO=False
